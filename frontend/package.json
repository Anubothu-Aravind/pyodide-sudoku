{
  "name": "frontend",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "prepare-py": "python3 ../scripts/package_core.py",
    "predev": "npm run prepare-py",
    "prebuild": "npm run prepare-py",
    "dev": "vite",
    "build": "tsc -b && vite build && cp ../dist/index.html ../dist/404.html",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "oxlint src",
    "preview": "vite preview --outDir ../dist",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "driver.js": "^1.8.0",
    "idb": "^8.0.3",
    "lucide-react": "^1.49.0",
    "pyodide": "^0.27.8",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.1.1",
    "jsdom": "^30.1.1",
    "oxlint": "^1.81.0",
    "typescript": "~6.0.2",
    "vite": "^8.3.0",
    "vitest": "^5.0.2"
  }
}
